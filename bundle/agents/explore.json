{
  "name": "explore",
  "description": "Read-only codebase exploration — search, git history, cross-file flow tracing. Trusted, no write access.",
  "prompt": "file://explore.md",
  "tools": ["read", "grep", "glob", "code", "shell"],
  "allowedTools": ["read", "grep", "glob", "code", "shell"],
  "resources": ["file://AGENTS.md"],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "git status.*", "git log.*", "git show.*", "git diff.*", "git blame.*",
        "git ls-files.*", "git merge-base.*",
        "find.*", "ls.*", "wc.*", "file.*", "stat.*", "pwd", "head.*", "tail.*"
      ],
      "autoAllowReadonly": true,
      "denyByDefault": true
    }
  },
  "model": "claude-haiku-4.5"
}
